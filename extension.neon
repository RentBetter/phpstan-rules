includes:
    - rules.neon

parametersSchema:
    ptgs: structure([
        noPublicCollectionReturn: schema(bool(), nullable())
        noDirectFlush: schema(bool(), nullable())
        noGenericId: schema(bool(), nullable())
        routeRequiresMethod: schema(bool(), nullable())
        routeRequiresUuidRequirement: schema(bool(), nullable())
        actionMethodNaming: schema(bool(), nullable())
        routeNameMatchesMethod: schema(bool(), nullable())
        readonlyService: schema(bool(), nullable())
        redundantReadonlyInReadonlyClass: schema(bool(), nullable())
        namedArgumentForBoolean: schema(bool(), nullable())
        namedArgumentOrder: schema(bool(), nullable())
        noSnakeCaseJsonKey: schema(bool(), nullable())
        noNullInJsonSerialize: schema(bool(), nullable())
        noRequestGetContentInController: schema(bool(), nullable())
        statusColumnMustBeEnum: schema(bool(), nullable())
        noHardcodedValueInQuery: schema(bool(), nullable())
        routePathCamelCase: schema(bool(), nullable())
        routeIdParamMustBeString: schema(bool(), nullable())
        noGetPayloadInController: schema(bool(), nullable())
        noJsonDecodeInController: schema(bool(), nullable())
        noMultipleRequestParamsInController: schema(bool(), nullable())
        saveParameterDefault: schema(bool(), nullable())
        noEntityAsFormDataClass: schema(bool(), nullable())
        noClassLevelRoute: schema(bool(), nullable())
        entityTablePrefix: schema(bool(), nullable())
        entityDeferredExplicit: schema(bool(), nullable())
        redundantColumnType: schema(bool(), nullable())
        redundantJoinColumn: schema(bool(), nullable())
        forbiddenDependency: schema(bool(), nullable())
        ruleLevel: schema(int(), nullable())
        nullFilterFunction: schema(string(), nullable())
        groups: arrayOf(listOf(string()))
        forbiddenDependencies: arrayOf(listOf(structure([
            group: string()
            reason: string()
        ])))
    ])

parameters:
    ptgs:
        noPublicCollectionReturn: true
        noDirectFlush: true
        noGenericId: true
        routeRequiresMethod: true
        routeRequiresUuidRequirement: true
        actionMethodNaming: true
        routeNameMatchesMethod: true
        readonlyService: true
        redundantReadonlyInReadonlyClass: true
        namedArgumentForBoolean: true
        namedArgumentOrder: true
        noSnakeCaseJsonKey: true
        noNullInJsonSerialize: true
        noRequestGetContentInController: true
        statusColumnMustBeEnum: true
        noHardcodedValueInQuery: true
        routePathCamelCase: true
        routeIdParamMustBeString: true
        noGetPayloadInController: true
        noJsonDecodeInController: true
        noMultipleRequestParamsInController: true
        saveParameterDefault: true
        noEntityAsFormDataClass: true
        noClassLevelRoute: true
        entityTablePrefix: true
        entityDeferredExplicit: true
        redundantColumnType: true
        redundantJoinColumn: true
        forbiddenDependency: true
        ruleLevel: null
        nullFilterFunction: array_filter_nulls
        groups:
            controller: ['~\\Controller\\~']
            service:    ['~\\Services?\\~', '~\\Helpers?\\~']
            repository: ['~\\Repository\\~']
            entity:     ['~\\Entity\\~']
            command:    ['~\\Command\\~']
            migration:  ['~\\Migrations?\\~']
            project:    ['~^App\\\\~', '~^PTGS\\\\~']
            dbAccess:
                - 'Doctrine\ORM\EntityManagerInterface'
                - 'Doctrine\DBAL\Connection'
                - 'PDO'
        forbiddenDependencies:
            controller:
                - group: dbAccess
                  reason: 'Controllers must remain thin — push DB access into a service.'
                - group: repository
                  reason: 'Controllers should depend on services, not repositories directly.'
            service:
                - group: dbAccess
                  reason: 'Services must use repositories — repositories own all DB access.'
